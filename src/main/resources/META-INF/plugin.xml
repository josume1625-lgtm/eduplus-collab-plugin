<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.eduplus.collab.plugin</id>
    <name>EduPlus Collab - Real-time Teaching Collaboration Plugin</name>
    <vendor email="support@eduplus.com" url="https://www.eduplus.com">EduPlus Team</vendor>

    <description><![CDATA[
    <h2>EduPlus Real-time Teaching Collaboration Plugin</h2>
    <p>An IntelliJ IDEA plugin crafted for live computer science teaching and pair programming:</p>
    <ul>
        <li><b>Embedded Zero-dependency Server:</b> Launch a lightweight collaborative server directly within IDEA.</li>
        <li><b>Real-time Code Sync:</b> Bi-directional, low-latency code broadcasting and collaborative editing.</li>
        <li><b>Dual-cursor Visualization:</b> Personalized cursors (Teacher Blue, Student Orange) with multi-line selection highlights.</li>
        <li><b>Teaching Control Modes:</b> Toggle smoothly between Teacher Exclusive (read-only) and Interactive Collaboration modes.</li>
    </ul>
    ]]></description>

    <!-- Platform compatibility dependencies -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Right ToolWindow Teaching Control Panel -->
        <toolWindow id="EduPlus Collab"
                    secondary="true"
                    icon="AllIcons.General.Web"
                    anchor="right"
                    factoryClass="com.eduplus.collab.ui.TeachingToolWindowFactory"/>

        <!-- Project-level collaboration session manager -->
        <projectService serviceImplementation="com.eduplus.collab.service.TeachingSessionService"/>

        <!-- Editor listener and remote cursor activity -->
        <postStartupActivity implementation="com.eduplus.collab.editor.CollabEditorStartupActivity"/>
    </extensions>

    <actions>
        <!-- Menu and toolbar actions -->
        <group id="EduPlus.CollabGroup" text="EduPlus Collab" popup="true" icon="AllIcons.Actions.QuickfixBulb">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="EduPlus.ToggleSession"
                    class="com.eduplus.collab.ui.action.ToggleCollabAction"
                    text="Start/Stop EduPlus Collaboration"
                    description="Toggle local collaboration server status"/>
        </group>
    </actions>
</idea-plugin>
